{
  "schema": "https://json.schemastore.org/pubspec.json",
  "name": "newswatch",
  "description": "A modern Flutter news application with authentication, category selection, and real-time news updates.",
  "version": "1.0.0+1",
  "homepage": "https://github.com/yourusername/newswatch",
  "environment": {
    "sdk": ">=3.0.0 <4.0.0"
  },
  "dependencies": {
    "flutter": {
      "sdk": "flutter"
    },
    "flutter_riverpod": "^2.4.0",
    "riverpod": "^2.4.0",
    "shared_preferences": "^2.2.0"
  },
  "dev_dependencies": {
    "flutter_test": {
      "sdk": "flutter"
    },
    "flutter_lints": "^3.0.0"
  },
  "flutter": {
    "uses-material-design": true,
    "assets": [
      "assets/"
    ]
  }
}
